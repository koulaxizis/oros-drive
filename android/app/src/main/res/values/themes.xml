<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: each screen draws its own top bar (Ui.java) and
         lays itself out around the system bars. -->
    <style name="Drive" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:colorControlNormal">@color/dim</item>
    </style>
</resources>
